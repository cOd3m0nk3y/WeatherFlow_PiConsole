## =============================================================================
## WEATHERFLOW FORECAST PANEL AND BUTTON
## =============================================================================
<ForecastPanel>:

    ## Panel background and title
    PanelBackground:
        _panelTitle: 'Forecast'

    ## Forecast Conditions
    TitleField:
        text: 'Conditions'
        pos_hint: {'x': 18/262, 'y': 166/202}
        size_hint_x: 77/262
    Image:
        source: 'icons/weather/' + self.parent.forecastIcon + app.scaleSuffix
        pos_hint: {'x': 18/262, 'y': 83/202}
        size_hint: (77/262, 80/202)
        fit_mode: 'contain'
    SmallMultilineField:
        text: app.CurrentConditions.Met['Conditions']
        pos_hint: {'x': 110/262, 'y': 80/202}
        size_hint: (132/262, 62/202)
        halign: 'left'
        line_height: 1.2

    ## Forecast status
    BoldMultilineField:
        text: app.CurrentConditions.Met['Status']
        pos_hint: {'x': 0/262, 'y': 97/202}
        size_hint: (262/262, 35/202)

    ## Forecast windspeed
    TitleField:
        text: 'Wind Speed'
        pos_hint: {'x': 132/262, 'y': 166/202}
        size_hint_x: 110/262
    MediumField:
        text: app.CurrentConditions.Met['WindSpd'][0] + ' ' + app.CurrentConditions.Met['WindSpd'][1] + ' ' + app.CurrentConditions.Met['WindDir'][0]
        pos_hint: {'x': 132/262, 'y': 145/202}
        size_hint_x: (110/262)

    ## Forecast temperature
    TitleField:
        text: 'Temperature'
        pos_hint: {'x': 5/262, 'y': 65/202}
        size_hint_x: (125/262)
    MediumField:
        text: app.CurrentConditions.Met['Temp'][0] + app.CurrentConditions.Met['Temp'][1]
        pos_hint: {'x': 5/262, 'y': 43/202}
        size_hint_x: (125/262)
    SmallField:
        pos_hint: {'x': 5/262, 'y': 25/202}
        size_hint_x: (125/262)
        text: '[color=00a4b4ff][font=fonts/Inter-Bold.ttf]L: [/font]' + app.CurrentConditions.Met['lowTemp'][0]  + app.CurrentConditions.Met['lowTemp'][1]  + '[/color]' + '  ' + '[color=f05e40ff][font=fonts/Inter-Bold.ttf]H: [/font]' + app.CurrentConditions.Met['highTemp'][0] + app.CurrentConditions.Met['highTemp'][1] + '[/color]'

    ## Forecast rain/snowfall
    TitleField:
        text: app.CurrentConditions.Met['PrecipType']
        pos_hint: {'x': 152/262, 'y': 65/202}
        size_hint_x: (100/262)
    MediumField:
        text: app.CurrentConditions.Met['PrecipPercnt'][0] + app.CurrentConditions.Met['PrecipPercnt'][1]
        pos_hint: {'x': 152/262, 'y': 43/202}
        size_hint_x: (100/262)
    SmallField:
        text: '[color=ffffffff]Daily[/color]: ' + app.CurrentConditions.Met['PrecipDay'][0] + app.CurrentConditions.Met['PrecipDay'][1]
        pos_hint: {'x': 152/262, 'y': 25/202}
        size_hint_x: (100/262)

    ## Forecast valid time
    SmallField:
        text: 'Forecast for ' + app.CurrentConditions.Met['Valid']
        pos_hint: {'x': 5/262, 'y': 2/202}
        size_hint: (252/262, 17/202)
        text_size: self.size
        halign: 'right'

<ForecastButton>:
    PanelButton:
        text: 'Forecast'
        on_release: app.CurrentConditions.switchPanel(self)

## =============================================================================
## SAGER FORECAST PANEL AND BUTTON
## =============================================================================
<SagerPanel>:

    ## Panel background and title
    PanelBackground:
        _panelTitle: 'Sager'

    ## Sager Weathercaster forecast
    MediumMultilineField:
        text: app.CurrentConditions.Sager['Forecast']
        pos_hint: {'x': 5/262, 'y': 21/202}
        size_hint: (252/262, 157/202)

    ## Forecast issue time
    SmallField:
        text: 'Forecast issued: ' + app.CurrentConditions.Sager['Issued']
        pos_hint: {'x': 5/262, 'y': 2/202}
        size_hint: (252/262, 17/202)
        text_size: self.size
        halign: 'right'

<SagerButton>:
    PanelButton:
        text: 'Sager'
        on_release: app.CurrentConditions.switchPanel(self)

## =============================================================================
## EXTENDED 10-DAY FORECAST PANEL AND BUTTON
## =============================================================================
<ExtendedForecastDay>:
    Label:
        text: root.day['day']
        color: utils.rgba('#ffffffff')
        font_name: 'fonts/Inter-Bold.ttf'
        font_size: dp((8 if root.compact else 12)*app.scaleFactor)
        size_hint: (1, .18 if root.compact else .16)
        pos_hint: {'x': 0, 'top': 1}
    Label:
        text: root.day['date'] if not root.compact else ''
        color: utils.rgba('#807e76ff')
        font_name: 'fonts/Inter-Regular.ttf'
        font_size: dp(8*app.scaleFactor)
        size_hint: (1, .10)
        pos_hint: {'x': 0, 'top': .85}
    Image:
        source: 'icons/weather/' + root.day['icon'] + app.scaleSuffix
        fit_mode: 'contain'
        size_hint: (.78 if root.compact else .62, .38)
        pos_hint: {'center_x': .5, 'y': .36 if root.compact else .40}
    Label:
        text: '[color=f05e40ff]' + root.day['high'] + '[/color]' + ("\n" if root.compact else '  ') + '[color=00a4b4ff]' + root.day['low'] + '[/color]'
        markup: True
        color: utils.rgba('#c8c8c8ff')
        font_name: 'fonts/Inter-SemiBold.ttf'
        font_size: dp((7 if root.compact else 10)*app.scaleFactor)
        line_height: .9
        size_hint: (1, .23 if root.compact else .17)
        pos_hint: {'x': 0, 'y': .15 if root.compact else .25}
    Label:
        text: root.day['conditions'] if not root.compact else root.day['precip']
        color: utils.rgba('#c8c8c8ff') if not root.compact else utils.rgba('#00a4b4ff')
        font_name: 'fonts/Inter-Regular.ttf'
        font_size: dp((7 if root.compact else 8)*app.scaleFactor)
        max_lines: 1 if root.compact else 2
        text_size: self.size
        halign: 'center'
        valign: 'center'
        size_hint: (.96, .17)
        pos_hint: {'center_x': .5, 'y': 0 if root.compact else .08}
    Label:
        text: (root.day['precip'] + ' precip') if not root.compact else ''
        color: utils.rgba('#00a4b4ff')
        font_name: 'fonts/Inter-SemiBold.ttf'
        font_size: dp(7*app.scaleFactor)
        text_size: self.size
        halign: 'center'
        valign: 'center'
        size_hint: (.96, .07)
        pos_hint: {'center_x': .5, 'y': 0}
        opacity: 0 if root.compact else 1

<ExtendedForecastPanel>:
    PanelBackground:
        _panelTitle: '10 Day Forecast'

    ExtendedForecastDay:
        day: root.days[0]
        pos_hint: {'x': 5/262, 'y': 82/202}
        size_hint: (80/262, 99/202)
    ExtendedForecastDay:
        day: root.days[1]
        pos_hint: {'x': 91/262, 'y': 82/202}
        size_hint: (80/262, 99/202)
    ExtendedForecastDay:
        day: root.days[2]
        pos_hint: {'x': 177/262, 'y': 82/202}
        size_hint: (80/262, 99/202)

    ExtendedForecastDay:
        day: root.days[3]
        compact: True
        pos_hint: {'x': 5/262, 'y': 5/202}
        size_hint: (34/262, 71/202)
    ExtendedForecastDay:
        day: root.days[4]
        compact: True
        pos_hint: {'x': 41.3/262, 'y': 5/202}
        size_hint: (34/262, 71/202)
    ExtendedForecastDay:
        day: root.days[5]
        compact: True
        pos_hint: {'x': 77.6/262, 'y': 5/202}
        size_hint: (34/262, 71/202)
    ExtendedForecastDay:
        day: root.days[6]
        compact: True
        pos_hint: {'x': 113.9/262, 'y': 5/202}
        size_hint: (34/262, 71/202)
    ExtendedForecastDay:
        day: root.days[7]
        compact: True
        pos_hint: {'x': 150.2/262, 'y': 5/202}
        size_hint: (34/262, 71/202)
    ExtendedForecastDay:
        day: root.days[8]
        compact: True
        pos_hint: {'x': 186.5/262, 'y': 5/202}
        size_hint: (34/262, 71/202)
    ExtendedForecastDay:
        day: root.days[9]
        compact: True
        pos_hint: {'x': 222.8/262, 'y': 5/202}
        size_hint: (34/262, 71/202)

<ExtendedForecastButton>:
    PanelButton:
        text: '10 Day'
        on_release: app.CurrentConditions.switchPanel(self)
